# Kopiya iyi dosiye uyite ".env" hanyuma wuzuze amakuru yawe

# Server
PORT=4000
JWT_SECRET=hindura-iri-jambo-ryibanga-rirerire-kandi-ridasanzwe

# Super Admin (wowe, nyir'application) - yiyandikisha ubwo mbere sisitemu itangiye
SUPERADMIN_NAME=Tiradukunda
SUPERADMIN_EMAIL=tiradukunda57@gmail.com
SUPERADMIN_PASSWORD=hindura-iri-password-mbere-yo-gutangira
SUPERADMIN_PHONE=0794619289

# Commission - inimero amafaranga ya commission ajyanwaho (guhera ku 0 kugeza 1, urugero 0.05 = 5%)
COMMISSION_RATE=0.05
COMMISSION_PHONE=0794619289

# --- Izi zikurikira ni OPTIONAL. Nta na imwe yanditsemo ubu, sisitemu izakora
# ariko izajya yandika notifications muri dashboard/log aho kohereza SMS/email nyakuri ---

# SMS provider (urugero: Africa's Talking) - niba utazuzuza, SMS zizajya zandikwa muri log gusa
AT_USERNAME=
AT_API_KEY=

# Email (SMTP) yo kohereza approval emails ku ba admin bashya
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Anthropic API key - niba wayishyizeho, dashboard izatanga incamake ya AI mu magambo
# (niba idahari, "AI insights" izakomeza gukora ikoresheje calculations gusa, nta narrative text)
ANTHROPIC_API_KEY=
